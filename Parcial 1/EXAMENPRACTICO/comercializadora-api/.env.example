# Environment variables for comercializadora-api.
#
# Copy to `.env` and adjust when you need something other than the defaults
# below (ConfigModule loads `.env` from the working directory).
# Every variable is optional: `src/config/env.ts` holds the same defaults.

# Port the NestJS API listens on.
PORT=3001

# PostgreSQL database of the retailer (docker-compose: user gr8 / gr8pass).
# TypeORM runs the migrations in src/database/migrations on startup.
DATABASE_URL=postgres://gr8:gr8pass@localhost:5432/comercializadora

# Public base URL of the NEXT.JS app, not of this API: the browser keeps
# talking to localhost:3000, whose rewrite proxies /api/* here, so the session
# cookies belong to the web origin. Better Auth uses it to build its URLs.
BETTER_AUTH_URL=http://localhost:3000

# Secret used to sign the auth cookies. The default is a DEV ONLY value
# (dev-only-insecure-secret-change-me-32chars) so the project runs out of the
# box; set a unique 32+ character secret anywhere that is not your machine.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-32chars

# Origin allowed to call the auth endpoints (the Next.js app).
WEB_ORIGIN=http://localhost:3000
