# Environment variables for comercializadora-web.
# Copy to `.env.local` (git-ignored) only when you need something other than the default.
# Read by next.config.ts at startup: restart `npm run dev` or rebuild before `next start`.

# URL of the NestJS API (comercializadora-api). The browser never calls it directly:
# Next.js proxies /api/* there, so the session cookie stays on this origin.
# No secret is needed here: the API validates each user's Better Auth session cookie.
API_URL=http://localhost:3001
