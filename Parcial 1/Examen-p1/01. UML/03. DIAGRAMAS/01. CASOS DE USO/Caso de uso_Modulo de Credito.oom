<a:Text>Módulo de Crédito</a:Text>
<a:CreationDate>1733334972</a:CreationDate>
<a:ModificationDate>1733959528</a:ModificationDate>
<a:Rect>((-6336,11543), (5811,15142))</a:Rect>
