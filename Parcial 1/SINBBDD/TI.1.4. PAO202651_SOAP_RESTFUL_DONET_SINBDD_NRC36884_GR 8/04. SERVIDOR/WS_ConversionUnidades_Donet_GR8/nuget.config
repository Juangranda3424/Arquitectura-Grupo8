<?xml version="1.0" encoding="utf-8"?>
<!-- Garantiza que la solucion restaure desde nuget.org aunque la maquina solo tenga fuentes offline. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
