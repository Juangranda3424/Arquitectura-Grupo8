<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Conversión de Unidades GR8</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="barra">
        <span class="marca">Conversión de Unidades · GR8</span>
        @if (ViewData["Usuario"] is string usuario && !string.IsNullOrEmpty(usuario))
        {
            <form asp-controller="Autenticacion" asp-action="Logout" method="post" class="sesion">
                <span>@usuario</span>
                <button type="submit" class="btn-salir">Cerrar sesión</button>
            </form>
        }
    </header>

    <main class="contenedor">
        @RenderBody()
    </main>
</body>
</html>
