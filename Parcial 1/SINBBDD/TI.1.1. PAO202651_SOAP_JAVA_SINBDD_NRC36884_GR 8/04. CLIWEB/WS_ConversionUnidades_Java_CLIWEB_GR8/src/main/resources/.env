# ============================================================
#  Configuración del cliente web  (WS_ConversionUnidades_Java_CLIWEB_GR8)
#  Después de cambiar algo aquí: vuelve a desplegar (Run en NetBeans).
# ============================================================

# --- Dónde está el servidor SOAP ---------------------------
# IP o nombre de la máquina donde corre Payara con el servidor.
# Ejemplos: localhost | 192.168.1.50 | 10.0.0.7
WS_HOST=localhost

# Puerto HTTP de Payara (por defecto 8080)
WS_PORT=8080

# Contexto del WAR del servidor (nombre con que se desplegó)
WS_CONTEXT=WS_ConUni_Java_GR8-1.0-SNAPSHOT

# --- Opcional: URL completa (si la pones, ignora HOST/PORT/CONTEXT) ---
WS_BASE_URL=http://localhost:8080/WS_ConversionUnidades_Java_GR8

# --- Avanzado: NO cambiar la IP aquí ------------------------
# Es solo un identificador XML del header <Token>; debe coincidir con
# Constantes.NAMESPACE del servidor aunque el servidor esté en otra IP.
WS_TOKEN_NAMESPACE=http://localhost:8080/
# Se lee solo del ?wsdl; únicamente se usa si el WSDL no responde.
WS_NAMESPACE=http://webservicio.monster.edu.ec/
