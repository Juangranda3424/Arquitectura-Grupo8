<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The SOAP server runs over plain HTTP on the developer PC: 10.0.2.2 from the emulator,
        or the PC LAN IP (SoapHelper.PC_IP) from a physical device. That IP changes with the
        network, so cleartext is allowed for any host instead of a fixed list.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
