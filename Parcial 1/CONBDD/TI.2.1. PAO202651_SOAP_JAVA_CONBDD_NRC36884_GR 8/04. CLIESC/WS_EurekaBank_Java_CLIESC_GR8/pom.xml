<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ec.edu.monster</groupId>
    <artifactId>WS_EurekaBank_Java_CLIESC_GR8</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <dependencies>
        <!-- Jakarta XML Web Services API -->
        <dependency>
            <groupId>jakarta.xml.ws</groupId>
            <artifactId>jakarta.xml.ws-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        
        <!-- Jakarta XML Web Services Runtime -->
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.0</version>
        </dependency>
        
        <!-- Jakarta XML Bind API -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        
        <!-- Jakarta Annotations API -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
        </dependency>
    </dependencies>
    
     <build>
        <finalName>WS_EurekaBank_Java_CLIESC_GR8</finalName>
        <resources>
            <resource>
                <targetPath>META-INF</targetPath>
                <directory>src</directory>
                <includes>
                    <include>jax-ws-catalog.xml</include>
                    <include>wsdl/**</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <exec.mainClass>ec.edu.monster.cliesc.WS_EurekaBank_Java_CLIESC_GR8</exec.mainClass>
        <!-- Contexto del servidor SOAP (04. SERVIDOR/WS_EurekaBank_Java_GR8) -->
        <wsdl.base>http://localhost:8080/WS_EurekaBank_Java_GR8</wsdl.base>
    </properties>

    <!--
        Los stubs JAX-WS generados viven en src/main/java/ec/edu/monster/ws y el build
        por defecto NO necesita red. Para regenerarlos (con el servidor arriba) ejecutar:
            mvn -P regen-wsdl generate-sources
    -->
    <profiles>
        <profile>
            <id>regen-wsdl</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.sun.xml.ws</groupId>
                        <artifactId>jaxws-maven-plugin</artifactId>
                        <version>4.0.1</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>wsimport</goal>
                                </goals>
                                <configuration>
                                    <wsdlUrls>
                                        <wsdlUrl>${wsdl.base}/WSLogin?wsdl</wsdlUrl>
                                    </wsdlUrls>
                                    <packageName>ec.edu.monster.ws</packageName>
                                    <vmArgs>
                                        <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                                    </vmArgs>
                                    <sourceDestDir>${project.basedir}/src/main/java</sourceDestDir>
                                    <keep>true</keep>
                                </configuration>
                                <id>wsimport-generate-WSLogin</id>
                                <phase>generate-sources</phase>
                            </execution>
                            <execution>
                                <goals>
                                    <goal>wsimport</goal>
                                </goals>
                                <configuration>
                                    <wsdlUrls>
                                        <wsdlUrl>${wsdl.base}/WSCuenta?wsdl</wsdlUrl>
                                    </wsdlUrls>
                                    <packageName>ec.edu.monster.ws</packageName>
                                    <vmArgs>
                                        <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                                    </vmArgs>
                                    <sourceDestDir>${project.basedir}/src/main/java</sourceDestDir>
                                    <keep>true</keep>
                                </configuration>
                                <id>wsimport-generate-WSCuenta</id>
                                <phase>generate-sources</phase>
                            </execution>
                            <execution>
                                <goals>
                                    <goal>wsimport</goal>
                                </goals>
                                <configuration>
                                    <wsdlUrls>
                                        <wsdlUrl>${wsdl.base}/WSMovimiento?wsdl</wsdlUrl>
                                    </wsdlUrls>
                                    <packageName>ec.edu.monster.ws</packageName>
                                    <vmArgs>
                                        <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                                    </vmArgs>
                                    <sourceDestDir>${project.basedir}/src/main/java</sourceDestDir>
                                    <keep>true</keep>
                                </configuration>
                                <id>wsimport-generate-WSMovimiento</id>
                                <phase>generate-sources</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
