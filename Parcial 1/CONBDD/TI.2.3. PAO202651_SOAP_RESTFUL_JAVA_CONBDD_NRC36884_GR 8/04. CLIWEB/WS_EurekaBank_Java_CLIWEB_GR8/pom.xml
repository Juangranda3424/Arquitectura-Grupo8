<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ec.edu.monster</groupId>
    <artifactId>WS_EurekaBank_Java_CLIWEB_GR8</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>WS_EurekaBank_Java_CLIWEB_GR8</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee>10.0.0</jakartaee>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSP API -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson para JSON -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- Jakarta Standard Tag Library -->
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Context root del cliente web: http://localhost:8080/WS_EurekaBank_Java_CLIWEB_GR8/ -->
        <finalName>WS_EurekaBank_Java_CLIWEB_GR8</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Arranque local con Payara Micro (Jakarta EE 11). Opt-in: no afecta al build normal.

                mvn -Prun package     compila y arranca el cliente web en http://localhost:8081
                mvn -Prun exec:exec   arranca sin recompilar, usando el WAR ya empaquetado

            El cliente web usa el puerto 8081 para convivir con el servidor REST, que corre
            en 8080 con el mismo perfil. RestApiClient sigue apuntando a localhost:8080.

            Payara Micro se descarga la primera vez desde Maven Central a target/;
            usa el `java` del PATH, que debe ser JDK 21 (Payara 7 corre sobre Java SE 21).
        -->
        <profile>
            <id>run</id>
            <properties>
                <payara.micro.version>7.2026.10</payara.micro.version>
                <payara.micro.port>8081</payara.micro.port>
                <payara.micro.jar>${project.build.directory}/payara-micro-${payara.micro.version}.jar</payara.micro.jar>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copiar-payara-micro</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>fish.payara.extras</groupId>
                                            <artifactId>payara-micro</artifactId>
                                            <version>${payara.micro.version}</version>
                                            <type>jar</type>
                                            <outputDirectory>${project.build.directory}</outputDirectory>
                                            <destFileName>payara-micro-${payara.micro.version}.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${payara.micro.jar}</argument>
                                <argument>--port</argument>
                                <argument>${payara.micro.port}</argument>
                                <argument>--noCluster</argument>
                                <argument>--rootDir</argument>
                                <argument>${project.build.directory}/payara-micro</argument>
                                <argument>--deploy</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.war</argument>
                            </arguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>arrancar-payara-micro</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
