<a:Creator>Admin</a:Creator>
<a:ModificationDate>1779156720</a:ModificationDate>
<a:Modifier>Admin</a:Modifier>
<a:Comment>RF-04: Registrar deposito/retiro/transferencia de forma atomica, validando fondos y activando el bloqueo de exclusion mutua.</a:Comment>
</o:UseCase>
</c:UseCases>
