<c:UseCases>
<o:UseCase Id="o39">
<a:ObjectID>CA4A3F0A-939E-4402-9935-860017528F9D</a:ObjectID>
<a:Name>CU 1.4 Gestionar Login</a:Name>
<a:Code>CU_LOGIN</a:Code>
<a:CreationDate>1779156720</a:CreationDate>
<a:Creator>Admin</a:Creator>
<a:ModificationDate>1779157482</a:ModificationDate>
<a:Modifier>Admin</a:Modifier>
<a:Comment>RF-01: Validar credenciales (usuario y clave) contra la BD  y retornar el perfil autorizado con su codigo de sucursal.</a:Comment>
</o:UseCase>
<o:UseCase Id="o40">
<a:ObjectID>DBF9F2EB-A52D-43CB-8A56-8053D113114A</a:ObjectID>
<a:Name>CU 1.1 Obtener Cuentas con Clientes</a:Name>
<a:Code>CU_CUENTAS</a:Code>
<a:CreationDate>1779156720</a:CreationDate>
<a:Creator>Admin</a:Creator>
<a:ModificationDate>1779156720</a:ModificationDate>
<a:Modifier>Admin</a:Modifier>
<a:Comment>RF-02: Consultar cuentas de una sucursal con saldo, moneda, titular e identificador de disponibilidad (verde/rojo).</a:Comment>
</o:UseCase>
<o:UseCase Id="o41">
<a:ObjectID>2828F5B2-B216-4A49-884F-F24200C58B6E</a:ObjectID>
<a:Name>CU 1.2 Obtener Movimientos</a:Name>
<a:Code>CU_MOVIMIENTOS</a:Code>
<a:CreationDate>1779156720</a:CreationDate>
<a:Creator>Admin</a:Creator>
<a:ModificationDate>1779156720</a:ModificationDate>
<a:Modifier>Admin</a:Modifier>
<a:Comment>RF-03: Consultar historial detallado de movimientos de una cuenta ordenados por fecha descendente.</a:Comment>
</o:UseCase>
<o:UseCase Id="o42">
<a:ObjectID>07332F86-E489-4CA4-8367-4C44AD84659A</a:ObjectID>
<a:Name>CU 1.3 Registrar Movimiento</a:Name>
<a:Code>CU_REGISTRAR</a:Code>
