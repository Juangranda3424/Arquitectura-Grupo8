<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuentes de paquetes para el proyecto TI.2.4 (servidor ASP.NET Core + clientes .NET).
  Se declara nuget.org de forma explícita para que `dotnet build` y `msbuild -restore`
  funcionen sin depender de la configuración global de cada equipo.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
