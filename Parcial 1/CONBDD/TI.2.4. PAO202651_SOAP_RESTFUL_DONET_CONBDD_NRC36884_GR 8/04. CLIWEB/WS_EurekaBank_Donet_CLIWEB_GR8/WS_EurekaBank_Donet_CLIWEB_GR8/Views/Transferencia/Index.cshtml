@model TransferenciaViewModel
@{
    ViewData["Title"] = "Transferencia";
}

<section class="page-head">
    <h1>Transferencia</h1>
    <p>Transfiera un monto entre dos cuentas.</p>
</section>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success">
        @Model.Mensaje
        @if (Model.Saldo.HasValue)
        {
            <strong>Saldo actual de la cuenta origen: S/ @Model.Saldo.Value.ToString("N2")</strong>
        }
    </div>
}

<div class="card">
    <h2 class="card-title">Nueva transferencia</h2>
    <p class="card-subtitle">La cuenta origen y destino deben ser diferentes.</p>

    <form asp-action="Index" method="post">
        <div class="field">
            <label class="label" asp-for="CuentaOrigen">Cuenta origen</label>
            <input class="input" asp-for="CuentaOrigen" placeholder="Ej. 00200001" />
            <span class="field-error" asp-validation-for="CuentaOrigen"></span>
        </div>

        <div class="field">
            <label class="label" asp-for="CuentaDestino">Cuenta destino</label>
            <input class="input" asp-for="CuentaDestino" placeholder="Ej. 00100001" />
            <span class="field-error" asp-validation-for="CuentaDestino"></span>
        </div>

        <div class="field">
            <label class="label" asp-for="Monto">Monto a transferir</label>
            <input class="input" asp-for="Monto" type="number" step="0.01" min="0.01" placeholder="0.00" />
            <span class="field-error" asp-validation-for="Monto"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Registrar transferencia</button>
        </div>
    </form>
</div>
