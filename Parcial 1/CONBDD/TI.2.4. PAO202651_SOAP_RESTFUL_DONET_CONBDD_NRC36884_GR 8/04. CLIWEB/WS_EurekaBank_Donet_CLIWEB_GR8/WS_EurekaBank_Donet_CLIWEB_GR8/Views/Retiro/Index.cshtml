@model OperacionViewModel
@{
    ViewData["Title"] = "Retiro";
}

<section class="page-head">
    <h1>Retiro</h1>
    <p>Registre un retiro de la cuenta indicada.</p>
</section>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success">
        @Model.Mensaje
        @if (Model.Saldo.HasValue)
        {
            <strong>Saldo actual: S/ @Model.Saldo.Value.ToString("N2")</strong>
        }
    </div>
}

<div class="card">
    <h2 class="card-title">Nuevo retiro</h2>
    <p class="card-subtitle">El saldo de la cuenta se actualiza al confirmar la operación.</p>

    <form asp-action="Index" method="post">
        <div class="field">
            <label class="label" asp-for="Cuenta">Número de cuenta</label>
            <input class="input" asp-for="Cuenta" placeholder="Ej. 00200001" />
            <span class="field-error" asp-validation-for="Cuenta"></span>
        </div>

        <div class="field">
            <label class="label" asp-for="Monto">Monto a retirar</label>
            <input class="input" asp-for="Monto" type="number" step="0.01" min="0.01" placeholder="0.00" />
            <span class="field-error" asp-validation-for="Monto"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Registrar retiro</button>
        </div>
    </form>
</div>
