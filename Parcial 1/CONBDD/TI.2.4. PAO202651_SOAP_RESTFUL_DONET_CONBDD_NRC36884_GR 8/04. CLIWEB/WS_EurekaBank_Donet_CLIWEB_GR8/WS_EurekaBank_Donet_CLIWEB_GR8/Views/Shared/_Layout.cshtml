@{
    var usuario = ViewData["Usuario"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · EurekaBank</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <svg class="logo" viewBox="0 0 48 48" role="img" aria-label="EurekaBank">
                <rect x="1" y="1" width="46" height="46" rx="12" fill="#0FA3B1" />
                <path d="M15 14h18M15 14v20M15 24h14M15 34h18" stroke="#FFFFFF" stroke-width="4.5" stroke-linecap="round" fill="none" />
                <circle cx="37" cy="37" r="4" fill="#F2A541" />
            </svg>
            <span class="brand-text">
                <strong>EurekaBank</strong>
                <small>Grupo 8 · Arquitectura de Software</small>
            </span>
        </a>

        @if (!string.IsNullOrEmpty(usuario))
        {
            <div class="topbar-user">
                <span class="user-chip">@usuario</span>
                <form asp-controller="Login" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-ghost">Cerrar sesión</button>
                </form>
            </div>
        }
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        TI.2.4 · SOAP_RESTFUL_DONET · CONBDD — NRC 36884 · Grupo 8
    </footer>
</body>
</html>
