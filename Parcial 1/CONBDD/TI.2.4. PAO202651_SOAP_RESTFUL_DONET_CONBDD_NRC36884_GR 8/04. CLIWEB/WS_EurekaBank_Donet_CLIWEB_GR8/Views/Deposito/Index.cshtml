@{
    ViewBag.Title = "Depósito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-head">
    <h1>Depósito</h1>
    <p>Registre un depósito en la cuenta indicada.</p>
</section>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}

<div class="card">
    <h2 class="card-title">Nuevo depósito</h2>
    <p class="card-subtitle">El saldo de la cuenta se actualiza al confirmar la operación.</p>

    @using (Html.BeginForm("Index", "Deposito", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="field">
            <label class="label" for="cuenta">Número de cuenta</label>
            <input class="input" type="text" id="cuenta" name="cuenta" placeholder="Ej. 00200001" required />
        </div>

        <div class="field">
            <label class="label" for="monto">Monto a depositar</label>
            <input class="input" type="number" id="monto" name="monto" placeholder="0.00" step="0.01" min="0.01" required />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Registrar depósito</button>
        </div>
    }
</div>
