@{
    ViewBag.Title = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title · EurekaBank</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
    <style>
        body {
            justify-content: center;
            align-items: center;
            padding: 24px;
            background: radial-gradient(circle at 15% 15%, #13315C 0%, #0B1F3A 55%, #071426 100%);
        }

        .login-shell {
            width: 100%;
            max-width: 420px;
            background: #FFFFFF;
            border-radius: 16px;
            box-shadow: 0 24px 60px rgba(4, 12, 24, 0.45);
            padding: 32px;
        }

        .login-brand {
            text-align: center;
            margin-bottom: 26px;
        }

        .login-brand svg {
            width: 64px;
            height: 64px;
            margin-bottom: 12px;
        }

        .login-brand h1 {
            margin: 0 0 4px;
            font-size: 24px;
            color: #0B1F3A;
        }

        .login-brand p {
            margin: 0;
            font-size: 13px;
            color: #64748B;
        }

        .login-separator {
            height: 1px;
            background: #E2E8F0;
            margin: 20px 0 22px;
        }

        .login-footer {
            margin-top: 20px;
            text-align: center;
            font-size: 11.5px;
            color: #64748B;
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-brand">
            <svg viewBox="0 0 48 48" role="img" aria-label="EurekaBank">
                <rect x="1" y="1" width="46" height="46" rx="12" fill="#0FA3B1" />
                <path d="M15 14h18M15 14v20M15 24h14M15 34h18" stroke="#FFFFFF" stroke-width="4.5" stroke-linecap="round" fill="none" />
                <circle cx="37" cy="37" r="4" fill="#F2A541" />
            </svg>
            <h1>EurekaBank</h1>
            <p>Grupo 8 · Arquitectura de Software</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Index", "Login", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="field">
                <label class="label" for="username">Usuario</label>
                <input class="input" type="text" id="username" name="username" placeholder="Ingrese su usuario" required autofocus />
            </div>

            <div class="field">
                <label class="label" for="password">Contraseña</label>
                <input class="input" type="password" id="password" name="password" placeholder="Ingrese su contraseña" required />
            </div>

            <div class="login-separator"></div>

            <button type="submit" class="btn btn-primary btn-block">Iniciar sesión</button>
        }

        <p class="login-footer">TI.2.4 · SOAP_RESTFUL_DONET · NRC 36884</p>
    </div>
</body>
</html>
