<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="WSEurekaBinding" maxReceivedMessageSize="1048576" maxBufferSize="1048576" sendTimeout="00:01:00" />
            </basicHttpBinding>
        </bindings>
        <client>
            <!-- Servidor WCF de TI.2.2 (04. SERVIDOR/WS_EurekaBank_Donet_GR8) -->
            <endpoint address="http://localhost:8090/WS_EurekaBank_Donet_GR8/webservicio/WSEureka.svc"
                binding="basicHttpBinding" bindingConfiguration="WSEurekaBinding"
                contract="WS_EurekaBank_Donet_CLICON_GR8.ec.edu.monster.servicio.IWSEureka" name="WSEurekaPort" />
        </client>
    </system.serviceModel>
</configuration>
