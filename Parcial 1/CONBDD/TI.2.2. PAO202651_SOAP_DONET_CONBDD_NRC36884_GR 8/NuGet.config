<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuente de paquetes para los proyectos .NET de TI.2.2.
  Se declara aqui para que la restauracion (MSBuild -restore -p:RestorePackagesConfig=true)
  funcione aunque el equipo no tenga nuget.org configurado como fuente global:
    - MySql.Data  : servidor WCF (04. SERVIDOR)
    - System.ServiceModel.* : cliente WinForms (04. CLIESC)
  La carpeta packages se ubica en la raiz de TI.2.2 para no exceder el limite de 260
  caracteres de Windows con las rutas internas de los paquetes.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="repositoryPath" value="packages" />
  </config>
</configuration>
