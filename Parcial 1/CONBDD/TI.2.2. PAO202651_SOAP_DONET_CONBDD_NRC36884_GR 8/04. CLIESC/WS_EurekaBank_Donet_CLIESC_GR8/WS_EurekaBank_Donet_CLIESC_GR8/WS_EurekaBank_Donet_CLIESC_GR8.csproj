    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WS_EurekaBank_Donet_CLIESC_GR8</RootNamespace>
    <AssemblyName>WS_EurekaBank_Donet_CLIESC_GR8</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
