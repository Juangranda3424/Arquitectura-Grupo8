@model MovimientoViewModel
@{
    ViewData["Title"] = "Registrar movimiento";
    ViewData["Usuario"] = Model.Usuario;
    var esTransferencia = Model.TipoMovimiento == TiposMovimiento.Transferencia;
}

<section class="tarjeta">
    <h2>Registrar movimiento</h2>
    <p class="ayuda">Depósito, retiro o transferencia mediante el servicio SOAP.</p>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alerta @(Model.Exito ? "alerta-exito" : "alerta-error")">@Model.Mensaje</div>
    }

    <form asp-action="Index" method="post" class="formulario">
        <label asp-for="Cuenta">Cuenta</label>
        <input asp-for="Cuenta" autocomplete="off" placeholder="Ej: 00100001" />
        <span asp-validation-for="Cuenta" class="error-campo"></span>

        <label asp-for="Importe">Importe</label>
        <input asp-for="Importe" type="number" step="0.01" min="0.01" placeholder="Ej: 150.00" />
        <span asp-validation-for="Importe" class="error-campo"></span>

        <label asp-for="TipoMovimiento">Tipo de movimiento</label>
        <select asp-for="TipoMovimiento" id="TipoMovimiento" required>
            @foreach (var tipo in TiposMovimiento.Todos)
            {
                <option value="@tipo.Codigo" selected="@(tipo.Codigo == Model.TipoMovimiento)">@tipo.Etiqueta</option>
            }
        </select>
        <span asp-validation-for="TipoMovimiento" class="error-campo"></span>

        <div id="grupoCuentaDestino" class="grupo @(esTransferencia ? "" : "oculto")">
            <label asp-for="CuentaDestino">Cuenta destino</label>
            <input asp-for="CuentaDestino" autocomplete="off" placeholder="Ej: 00100002" />
            <span asp-validation-for="CuentaDestino" class="error-campo"></span>
        </div>

        <button type="submit" class="boton">Registrar</button>
    </form>

    <a class="enlace" asp-controller="Menu" asp-action="Index">Regresar al menú</a>
</section>

<script>
    // La cuenta destino solo se solicita en las transferencias (código 008)
    const tipoMovimiento = document.getElementById('TipoMovimiento');
    const grupoCuentaDestino = document.getElementById('grupoCuentaDestino');
    const cuentaDestino = document.getElementById('CuentaDestino');

    tipoMovimiento.addEventListener('change', () => {
        const esTransferencia = tipoMovimiento.value === '@TiposMovimiento.Transferencia';
        grupoCuentaDestino.classList.toggle('oculto', !esTransferencia);
        if (!esTransferencia) {
            cuentaDestino.value = '';
        }
    });
</script>
